# Copy to .env (which is git-ignored) to override local defaults.
POSTGRES_DB=cloudcart
POSTGRES_USER=cloudcart
POSTGRES_PASSWORD=change-me-locally
# Enables /internal/chaos endpoints on order-service for incident drills.
CHAOS_ENABLED=false
# Host port for PostgreSQL. Change it if 5432 is already used on your machine.
POSTGRES_HOST_PORT=5432
