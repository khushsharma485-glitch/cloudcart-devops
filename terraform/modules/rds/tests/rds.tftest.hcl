# Offline tests for the RDS module (mocked AWS provider, nothing is created).

mock_provider "aws" {
  mock_resource "aws_iam_role" {
    defaults = { arn = "arn:aws:iam::123456789012:role/mock" }
  }
  mock_resource "aws_db_instance" {
    defaults = {
      arn                = "arn:aws:rds:eu-west-1:123456789012:db:mock"
      master_user_secret = [{ secret_arn = "arn:aws:secretsmanager:eu-west-1:123456789012:secret:rds!db-mock", kms_key_id = "k", secret_status = "active" }]
    }
  }
}

variables {
  identifier              = "cloudcart-test"
  vpc_id                  = "vpc-123"
  subnet_ids              = ["subnet-a", "subnet-b"]
  allowed_security_groups = { eks-cluster = "sg-eks" }
}

run "secure_defaults" {
  command = apply

  assert {
    condition     = aws_db_instance.this.publicly_accessible == false
    error_message = "RDS must never be publicly accessible"
  }

  assert {
    condition     = aws_db_instance.this.storage_encrypted
    error_message = "RDS storage must be encrypted"
  }

  assert {
    condition     = aws_db_instance.this.manage_master_user_password && aws_db_instance.this.password == null
    error_message = "The password must be generated by RDS and kept in Secrets Manager, never in Terraform"
  }

  assert {
    condition     = one([for p in aws_db_parameter_group.this.parameter : p.value if p.name == "rds.force_ssl"]) == "1"
    error_message = "TLS must be enforced for database connections"
  }

  assert {
    condition     = aws_db_instance.this.deletion_protection && aws_db_instance.this.final_snapshot_identifier == "cloudcart-test-final"
    error_message = "Default must protect against accidental deletion and take a final snapshot"
  }

  assert {
    condition     = length(aws_vpc_security_group_ingress_rule.postgres) == 1 && aws_vpc_security_group_ingress_rule.postgres["eks-cluster"].from_port == 5432
    error_message = "Only the listed security groups may reach port 5432"
  }

  assert {
    condition     = length(aws_cloudwatch_metric_alarm.this) == 4
    error_message = "CPU, storage, memory and connection alarms must exist"
  }

  assert {
    condition     = output.master_user_secret_arn == "arn:aws:secretsmanager:eu-west-1:123456789012:secret:rds!db-mock"
    error_message = "The Secrets Manager ARN must be exported for External Secrets"
  }
}

run "dev_can_skip_final_snapshot" {
  command = apply

  variables {
    deletion_protection = false
    skip_final_snapshot = true
  }

  assert {
    condition     = aws_db_instance.this.final_snapshot_identifier == null
    error_message = "No final snapshot identifier when skipping the snapshot"
  }
}
