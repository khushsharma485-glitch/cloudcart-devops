# Copy to terraform.tfvars (git-ignored) and adjust.
aws_region        = "eu-west-1"
github_repository = "khushsharma485-glitch/cloudcart-devops"

# Required: your public IP(s) allowed to reach the Kubernetes API.
# Find yours with: curl -s https://checkip.amazonaws.com
eks_public_endpoint_cidrs = ["203.0.113.10/32"]

